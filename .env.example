# Copy to .env and fill in your key from voice.intron.io -> Developer tab
INTRON_API_KEY=your-sahara-api-key-here

# Doctor voice-command agent (server-side only)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Optional overrides
INTRON_BASE_URL=https://infer.voice.intron.io
WHISPER_MODEL_SIZE=base
MMS_MODEL_ID=facebook/mms-1b-all
MMS_LID_MODEL_ID=facebook/mms-lid-126
